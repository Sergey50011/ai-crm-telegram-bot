# Токен бота от @BotFather
BOT_TOKEN=

# Ключ API с https://openrouter.ai/
OPENROUTER_API_KEY=

# Рекомендуется: ваш Telegram user id — только вы сможете вызывать /admin.
# Узнать id: @userinfobot. Пусто = /admin доступен всем (только для локального демо).
# Админы Telegram (/admin, /setstatus, уведомления). Один id:
# ADMIN_ID=123456789
# Несколько через запятую:
# ADMIN_IDS=123456789,987654321
# Пусто = демо (админ-команды доступны всем) — только локально

# Необязательно: модель OpenRouter (по умолчанию meta-llama/llama-3-8b-instruct:free)
# OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free

# Необязательно: путь к SQLite (по умолчанию orders.db)
# DATABASE_PATH=orders.db

# Веб-админка: Basic Auth (обязательно, не короче 8 символов)
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD=ваш_сложный_пароль

# Лимит текстовых сообщений на пользователя в минуту (по умолчанию 5)
# BOT_RATE_LIMIT_PER_MIN=5

# Одно сообщение: макс. символов и порог повторов одинаковой строки
# BOT_MAX_MESSAGE_CHARS=600
# BOT_REPEAT_LINE_THRESHOLD=3

# DEBUG — сырой JSON ответа OpenRouter в логах
# LOG_LEVEL=INFO

# Уведомление ADMIN_ID в Telegram о новой заявке (1/0, по умолчанию 1)
# NOTIFY_ON_NEW_LEAD=1

# Запасной разбор без ИИ, если OpenRouter не ответил (1/0, по умолчанию 1)
# BOT_FALLBACK_PARSE=1

# Google Sheets (см. docs/GOOGLE_SHEETS.md)
# SHEETS_ENABLED=0
# GOOGLE_SHEETS_ID=
# GOOGLE_SHEETS_WORKSHEET=Заявки
# GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-sa.json
